# ── App ────────────────────────────────────────────────────────
APP_NAME=HomeCare+
APP_ENV=development
DEBUG=True

# ── Database (PostgreSQL) ───────────────────────────────────────
# Local Postgres (create it once:  createdb homecare_plus):
DATABASE_URL=postgresql+asyncpg://homecare:homecare@localhost:5432/homecare_plus
#
# With `docker compose up` this is set for you (the compose file overrides it).
# Hosted Postgres (Neon / Supabase / Render / RDS …) — paste their URL as-is,
# postgres:// and postgresql:// are converted automatically. Add ?ssl=require if needed:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?ssl=require
#
# Connection pool (optional)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# ── JWT ────────────────────────────────────────────────────────
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (the app refuses to start with the default key when APP_ENV=production)
SECRET_KEY=homecare-super-secret-key-change-in-production-min-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS ───────────────────────────────────────────────────────
# JSON list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── File Storage ───────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ── AI / LLM API Keys (optional — database-backed symptom checker works without them) ──
# GROQ_API_KEY: primary chat model — fast & has a generous free tier.
#   Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# ANTHROPIC_API_KEY: used for image/report vision analysis, and as a
#   chat fallback if Groq is unavailable.
#   Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OPENAI_API_KEY: final fallback for both chat and vision analysis.
#   Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Image / report analysis (optional tuning) ───────────────────
# Vision works with ANY ONE of the three keys above. Groq's free key runs
# a vision model (see https://console.groq.com/docs/vision). Order = first available, rest are fallbacks.
# VISION_PROVIDER_ORDER=anthropic,openai,groq
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# OPENAI_VISION_MODEL=gpt-4o
# AI_VISION_TIMEOUT=90

# ── AI Model Names (optional overrides) ─────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o-mini

# ── Google Maps (optional) ─────────────────────────────────────
GOOGLE_MAPS_API_KEY=
